{
	"git": {
		"commitMessage": "chore(release): raf-effect-atom@${version}",
		"commitsPath": "packages/raf-effect-atom",
		"pushArgs": ["--follow-tags", "--atomic"],
		"requireCommits": true,
		"tagName": "raf-effect-atom@${version}"
	},
	"github": {
		"release": true,
		"releaseName": "raf-effect-atom@${version}"
	},
	"hooks": {
		"after:bump": "pnpm --filter raf-effect-atom exec npm pkg set version=${version}",
		"before:git:release": "pnpm --filter \"raf-effect-atom...\" build && cp LICENSE packages/raf-effect-atom/LICENSE && git fetch -q origin main && { test \"$(git rev-parse FETCH_HEAD)\" = \"$(git rev-parse HEAD)\" || { echo 'main moved during this release; the newer run releases it.'; exit 1; }; } && pnpm --filter raf-effect-atom run publish:npm"
	},
	"npm": false,
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "packages/raf-effect-atom/CHANGELOG.md",
			"tagPrefix": "raf-effect-atom@",
			"commitsOpts": {
				"path": "packages/raf-effect-atom"
			},
			"gitRawCommitsOpts": {
				"path": "packages/raf-effect-atom"
			},
			"preset": {
				"name": "conventionalcommits",
				"preMajor": true,
				"types": [
					{
						"effect": "bump",
						"section": "Features",
						"type": "feat"
					},
					{
						"effect": "bump",
						"section": "Bug Fixes",
						"type": "fix"
					},
					{
						"effect": "bump",
						"section": "Performance Improvements",
						"type": "perf"
					},
					{
						"effect": "changelog",
						"section": "Code Refactoring",
						"type": "refactor"
					},
					{
						"effect": "changelog",
						"section": "Documentation",
						"type": "docs"
					},
					{
						"effect": "changelog",
						"section": "Tests",
						"type": "test"
					},
					{
						"effect": "changelog",
						"section": "Build System",
						"type": "build"
					},
					{
						"effect": "changelog",
						"section": "Continuous Integration",
						"type": "ci"
					},
					{
						"effect": "changelog",
						"section": "Styles",
						"type": "style"
					},
					{
						"effect": "changelog",
						"section": "Miscellaneous Chores",
						"type": "chore"
					}
				]
			}
		}
	}
}
