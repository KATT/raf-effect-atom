{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": false,
		"incremental": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["ES2024", "DOM", "DOM.Iterable", "ESNext.Disposable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"~/*": ["./src/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": ["node"]
	},
	"include": [
		"next-env.d.ts",
		"src",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"next.config.ts"
	],
	"exclude": ["node_modules"]
}
