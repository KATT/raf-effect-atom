{
	"name": "effect-atom-boundary",
	"version": "0.2.0",
	"description": "Typed error boundaries for Effect Atom: catch an atom's failures by tag, typed by the atom",
	"keywords": [
		"effect",
		"effect-atom",
		"error-boundary",
		"react",
		"suspense"
	],
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/raf-effect-atom.git",
		"directory": "packages/effect-atom-boundary"
	},
	"homepage": "https://raf-effect-atom.katt.dev",
	"bugs": {
		"url": "https://github.com/KATT/raf-effect-atom/issues"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test && pnpm test-types",
