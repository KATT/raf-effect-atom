		"./lib/highlighter": "./src/lib/highlighter.tsx",
		"./lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"shadcn": "4.22.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"react": "19.2.0",
		"react-dom": "19.2.0"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@shadcn/react": "0.3.1",
		"class-variance-authority": "0.7.1",
		"cmdk": "1.1.1",
		"cn": "0.5.0",
		"date-fns": "4.4.0",
		"embla-carousel-react": "8.6.0",
		"input-otp": "1.5.0",
		"lucide-react": "1.61.0",
		"next-themes": "0.4.6",
		"react-day-picker": "10.0.2",
		"react-resizable-panels": "4.14.8",
		"recharts": "3.8.0",
		"shiki": "4.5.0",
		"sonner": "2.0.8"
	}
}
