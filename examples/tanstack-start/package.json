{
	"name": "@examples/tanstack-start",
	"version": "0.0.0",
	"private": true,
	"description": "The issue tracker on TanStack Start: atoms started from route loaders and streamed into the browser, over Effect RPC served from a server route",
	"type": "module",
	"imports": {
		"#rpc-transport": {
			"browser": "./src/rpc-transport.browser.ts",
			"default": "./src/rpc-transport.server.ts"
		}
	},
	"scripts": {
		"build": "vp build",
		"check:bundle": "bundle-check .output/public --forbid @examples/db --forbid @examples/backend",
		"dev": "vp dev --port 3005",
		"start": "vp preview --port 3005",
		"test": "vp test",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@effect/atom-react": "4.0.6",
		"@examples/backend": "workspace:*",
		"@examples/contract": "workspace:*",
		"@examples/kit": "workspace:*",
		"@examples/ui": "workspace:*",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"effect": "catalog:",
		"effect-atom-boundary": "workspace:*",
		"raf-effect-atom": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8"
	},
	"devDependencies": {
		"@babel/core": "8.0.7",
		"@effect/vitest": "catalog:",
		"@rolldown/plugin-babel": "0.2.4",
		"@tailwindcss/vite": "4.3.3",
		"@tooling/bundle-check": "workspace:*",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"babel-plugin-react-compiler": "1.0.0",
		"nitro": "3.0.260903-beta",
		"typescript": "7.0.2",
		"vite-plus": "1.4.0"
	}
}
