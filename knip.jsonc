{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// Every issue type fails the run. `nsExports` and `nsTypes` are off by
	// default; `cycles` is a warning by default. `pnpm knip` does not pass
	// `--strict`: that flag is production mode, which skips tests and
	// devDependencies, so it would miss unused code this run reports.
	"rules": {
		"files": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"optionalPeerDependencies": "error",
		"unlisted": "error",
		"binaries": "error",
		"unresolved": "error",
		"exports": "error",
		"nsExports": "error",
		"types": "error",
		"nsTypes": "error",
		"duplicates": "error",
		"enumMembers": "error",
		"namespaceMembers": "error",
		"catalog": "error",
		"catalogReferences": "error",
		"cycles": "error",
	},
	// An export used only in its own file does not need the `export` keyword.
	"ignoreExportsUsedInFile": false,
	// Private workspaces have no consumers outside this repo, so an export on
	// an entry file that nothing imports is unused. Packages that publish a
	// surface turn this off below.
	"includeEntryExports": true,
	"treatConfigHintsAsErrors": true,
	"treatTagHintsAsErrors": true,
	// Report a binary Knip does not already treat as a shell built-in. The
	// list below is the system commands this repo's scripts and release hooks
	// actually call.
	"ignoreGlobalBinaries": false,
	"ignoreBinaries": ["cp", "echo", "exit", "git", "node"],
	// `import()` still counts. A deferred import does not make a cycle safe.
	"cycles": {
		"dynamicImports": true,
	},
	// Vendored dependency checkouts. Not part of this repo's graph.
	"ignore": [".repos/**"],
	"workspaces": {
		".": {
			// Scripts the agent skills run with `node`.
			"entry": [".agents/skills/*/scripts/*.mjs"],
			"ignoreDependencies": [
				// `vp lint` / `vp fmt` load these. vite-plus depends on them
				// too; the root pins the versions those commands run.
				"oxfmt",
				"oxlint",
				"oxlint-tsgolint",
			],
			// One release-it config per package, passed with `--config`.
			"release-it": {
				"config": ["release-it/*.json"],
			},
		},
		"examples/.shared/ui": {
			// `package.json` exports are the shadcn kit. Components are added
			// with the CLI and stay available to the apps.
			"includeEntryExports": false,
		},
		"examples/nextjs": {
			"ignoreIssues": {
				// `#rpc-transport` resolves here under the `react-server` condition,
				// which Knip doesn't follow.
				"src/rpc-transport.server.ts": ["exports"],
			},
		},
		"examples/react-router": {
			"ignoreIssues": {
				// `#rpc-transport` resolves here under the `browser` condition,
				// which Knip doesn't follow.
				"app/rpc-transport.browser.ts": ["exports"],
				// `./+types/*` is generated by `react-router typegen` into
				// `.react-router/types` (tsconfig `rootDirs`); Knip doesn't run it.
				"app/{root,routes/**/*}.{ts,tsx}": ["unresolved"],
			},
		},
		"examples/tanstack-start": {
			"ignoreIssues": {
				// `#rpc-transport` resolves here under the `browser` condition,
				// which Knip doesn't follow.
				"src/rpc-transport.browser.ts": ["exports"],
			},
		},
		"www": {
			// The build reads the sample apps from disk and Twoslash resolves
			// their imports from each app's `node_modules`, so www installs
			// them. `sample:…` imports are a virtual module of
			// `build/content.ts`.
			"ignoreDependencies": [
				"@samples/nextjs",
				"@samples/react-router",
				"@samples/tanstack-start",
				"sample",
			],
		},
		"www/samples/*": {
			// The docs show these files through `sample` fences in markdown,
			// which Knip does not parse: every file is an entry, and its
			// exports are what the pages import.
			"entry": ["src/**/*.{ts,tsx}"],
			"includeEntryExports": false,
		},
		"www/samples/nextjs": {
			"entry": ["src/**/*.{ts,tsx}"],
			"includeEntryExports": false,
			"ignoreIssues": {
				// Knip resolves `#rpc-transport` under the `react-server`
				// condition only, so it misses client components' transport.
				"src/rpc-transport.ts": ["exports"],
			},
		},
		"www/samples/react-router": {
			"entry": ["app/**/*.{ts,tsx}"],
			"includeEntryExports": false,
			"ignoreIssues": {
				// `#rpc-transport` resolves here under the `browser` condition,
				// which Knip doesn't follow.
				"app/rpc-transport.ts": ["exports"],
				// `./+types/*` is generated by `react-router typegen` into
				// `.react-router/types` (tsconfig `rootDirs`); Knip doesn't run it.
				"app/{root,routes/*}.{ts,tsx}": ["unresolved"],
				// The app is only typechecked, never built, so it doesn't install
				// what React Router's default server entry imports.
				"react-router.config.ts": ["unlisted"],
			},
		},
		"tooling/rsc-frameworks": {
			// Each app is built by path from its test, with its own vite config.
			"entry": ["vite-rsc/vite.config.ts", "vite-rsc/entry.*.tsx"],
			"includeEntryExports": false,
		},
		"tooling/og-image": {
			// The renderer reads the font files through `import.meta.resolve`,
			// which Knip doesn't follow.
			"ignoreDependencies": ["@fontsource/inter", "@fontsource/jetbrains-mono"],
		},
		"tooling/oxlint-plugins": {
			// Loaded by path from the root `.oxlintrc.json`.
			"entry": [
				"anti-slop/index.ts",
				"anti-slop/effect/index.ts",
				"nkzw/index.ts",
				"workspace.ts",
			],
			"includeEntryExports": false,
		},
		"packages/effect-atom-boundary": {
			// tstyche type tests. The entry file is the published API.
			"entry": ["typetest/**/*.tst.tsx"],
			"includeEntryExports": false,
		},
		"packages/raf-effect-atom": {
			// tstyche type tests. The entry files are the published API.
			"entry": ["typetest/**/*.tst.{ts,tsx}"],
			"includeEntryExports": false,
		},
	},
}
