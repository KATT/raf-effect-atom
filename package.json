{
	"name": "raf-effect-atom-workspace",
	"private": true,
	"description": "Workspace root for raf-effect-atom",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"build:www": "pnpm --filter @raf-effect-atom/www build",
		"check:pack": "pack-check",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"knip": "knip",
		"lint": "vp lint -c .oxlintrc.json --disable-nested-config",
		"lint:fix": "vp lint -c .oxlintrc.json --fix --disable-nested-config",
		"prepare": "husky",
		"test": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" --filter \"./examples/.shared/*\" --filter \"./tooling/*\" --filter \"./www\" test",
		"typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" --filter \"./examples/.shared/*\" --filter \"./www\" --filter \"./www/samples/*\" --filter \"./tooling/*\" typecheck",
		"postinstall": "vendor-src check"
	},
	"devDependencies": {
		"@release-it/conventional-changelog": "12.0.2",
		"@tanstack/react-router": "1.170.46",
		"@tooling/pack-check": "workspace:*",
		"@types/node": "24.19.2",
		"effect": "catalog:",
		"eslint-plugin-no-only-tests": "3.4.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"husky": "9.1.7",
		"knip": "6.42.1",
		"lint-staged": "17.6.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"release-it": "21.1.1",
		"typescript": "7.0.2",
		"vendor-src": "0.16.0",
		"vite-plus": "1.4.0"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "vp lint -c .oxlintrc.json --fix --disable-nested-config --no-error-on-unmatched-pattern",
		"*": "vp fmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.15.0"
}
