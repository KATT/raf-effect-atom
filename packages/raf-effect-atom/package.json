{
	"name": "raf-effect-atom",
	"version": "0.2.1",
	"description": "Render-as-you-fetch for Effect Atom: start atoms from route loaders and stream them into the browser, typed failures intact",
	"keywords": [
		"effect",
		"effect-atom",
		"react",
		"render-as-you-fetch",
		"ssr",
		"suspense"
	],
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/raf-effect-atom.git",
		"directory": "packages/raf-effect-atom"
	},
	"homepage": "https://raf-effect-atom.katt.dev",
	"bugs": {
		"url": "https://github.com/KATT/raf-effect-atom/issues"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./next": "./src/Next.ts",
		"./react-router": "./src/ReactRouter.ts",
		"./tanstack-router": "./src/TanStackRouter.tsx"
	},
	"scripts": {
		"build": "vp pack",
		"test": "vp test && pnpm test-types",
		"test-types": "tstyche",
		"typecheck": "tsc",
		"publish:npm": "pnpm pack --out package.tgz && npm publish package.tgz --access public",
		"prepack": "cp ../../LICENSE LICENSE"
	},
	"peerDependencies": {
		"@effect/atom-react": "^4.0.6",
		"@tanstack/react-router": "^1.170.46",
		"effect": "^4.0.6",
		"react": "^19.2.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-router": {
			"optional": true
		}
	},
	"devDependencies": {
		"@effect/atom-react": "4.0.6",
		"@effect/vitest": "catalog:",
		"@tanstack/react-router": "1.170.46",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.0.5",
		"effect": "catalog:",
		"effect-atom-boundary": "workspace:*",
		"happy-dom": "21.0.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-error-boundary": "6.1.6",
		"react-router": "8.5.0",
		"react-server-dom-webpack": "19.3.1",
		"tstyche": "7.2.5",
		"typescript": "7.0.2",
		"vite-plus": "1.4.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs",
			"./next": "./dist/Next.mjs",
			"./react-router": "./dist/ReactRouter.mjs",
			"./tanstack-router": "./dist/TanStackRouter.mjs"
		},
		"provenance": true
	}
}
